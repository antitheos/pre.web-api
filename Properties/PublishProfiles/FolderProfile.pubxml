<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishProvider>FileSystem</PublishProvider>
    <PublishUrl>bin\Release\net9.0\publish\</PublishUrl>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <_TargetId>Folder</_TargetId>
    <!-- NO RuntimeIdentifier. A win-x64 RID publish trims ~4 MB of unused
         runtimes, but it also switches web.config from
         processPath="dotnet" arguments=".\pri.web-api.dll" to
         processPath=".\pri.web-api.exe", and that produced
         HTTP 500.31 "Failed to load ASP.NET Core runtime" on this server
         (2026-09-02). Portable is the known-good shape here; do not
         reintroduce a RID without deploying into an emptied folder and
         testing, because mixing portable and RID-specific output in one
         directory is itself a cause of 500.3x. -->
  </PropertyGroup>
</Project>